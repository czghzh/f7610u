+	/*
+	 * The clock may be a fixed-rate placeholder during bring-up on
+	 * ZX279131 (real clock tree not modeled yet).  Tolerate a refused
+	 * clk_set_rate and continue with whatever rate we got.
+	 */
 	ret = clk_set_rate(sfc->clk, max_freq);
 	if (ret)
-		return dev_err_probe(dev, ret,
