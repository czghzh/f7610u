+	if (!actual_rate)
+		return dev_err_probe(dev, -EINVAL,
+				     "invalid clock rate\n");
+	if (actual_rate > max_freq)
+		return dev_err_probe(dev, -ERANGE,
 				     "clock rate %lu exceeds requested %u Hz\n",
 				     actual_rate, max_freq);
 
